# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the app, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC key for each site's DNS TXT ownership token (server-side only)
SITE_VERIFICATION_SECRET=

# Shared secret between the app and the database's scheduled jobs (pg_cron)
APP_SECRET=

# Bearer token for the daily Domain Rating refresh cron
CRON_SECRET=

# Ahrefs APIv3 key (only the free domain-rating endpoint is used)
AHREFS_API_KEY=

# Transactional email via Resend
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=
